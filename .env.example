# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/buyeasy

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# Stripe  --  NEVER expose STRIPE_SECRET_KEY to the frontend
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email (Nodemailer)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
FROM_NAME=BuyEasy
FROM_EMAIL=noreply@buyeasy.com

# File Upload
FILE_UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Google Gemini AI (for agent features)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini chat model for the AI support agent.
# gemini-2.5-flash: GA model, function-calling + thinking. No shutdown date listed
# on ai.google.dev/gemini-api/docs/deprecations as of the date this file was written.
# Override to upgrade at any time without redeploying: e.g. gemini-3.0-flash (if/when GA).
GEMINI_MODEL=gemini-2.5-flash

# CORS — set to your Vercel frontend URL in production
FRONTEND_URL=https://frontend-nine-zeta-53.vercel.app

# ── RAG service (Phase 2) ─────────────────────────────────────────────────────
# Internal URL of the shopagent-rag AWS ECS service (no trailing slash)
# In development: http://localhost:8080 (if running rag-service locally)
# In production: set to the AWS ALB URL
RAG_SERVICE_URL=http://localhost:8080

# Shared secret for X-Internal-Key authentication between API and RAG service.
# Must match the RAG_SHARED_SECRET AWS Secret on both services.
# Generate (bash):        openssl rand -hex 32
# Generate (PowerShell):  [System.Guid]::NewGuid().ToString()
RAG_SHARED_SECRET=your-rag-shared-secret-here

# Gemini embedding model used by rag-service/ingest.py and rag-service/app.py.
# Do not change unless Google releases a new embedding model with 768 dims.
EMBED_MODEL=gemini-embedding-001

# Minimum cosine similarity score for RAG results (0.0–1.0).
# Lower this if legitimate questions miss; raise if off-topic results appear.
MIN_SCORE=0.6
